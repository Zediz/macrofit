# Genera un secreto real con: openssl rand -hex 32
JWT_SECRET="replace-with-openssl-rand-hex-32"
JWT_EXCLUDED_ROUTES="/auth/login,/auth/register"

HOST=
EMAIL=
EMAIL_PASSWORD=
PORT=
SENDER_NAME=

DB_HOST="mysql"
DB_NAME="macrofit"
DB_USER="root"
DB_PASSWORD="root_password"

# Opcionales que el código reconoce:
# APP_PORT=8888
# APP_DEBUG=false
# CORS_ALLOWED_ORIGINS="https://app.example.com"
# JWT_TTL=28800
# APP_TIMEZONE="America/Mexico_City"

# OCR de etiquetas. Crea la clave en https://aistudio.google.com/apikey
# y ponla en .env. No dejes este placeholder ni subas una clave real.
GEMINI_API_KEY="replace-with-a-google-ai-studio-key"
# Modelo del plan gratis. Cámbialo si AI Studio muestra otro flash.
GEMINI_MODEL="gemini-2.5-flash"
